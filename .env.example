# Copy this file to ".env" and fill in your own values.
# ".env" is ignored by git and must never be committed.
#
# These are placeholder values, NOT real credentials.
# Real API credentials are obtained at https://my.telegram.org
# and are only needed from stage 2 (real Telegram connection) onward.

# Telegram API credentials
TG_API_ID=123456
TG_API_HASH=replace_with_your_api_hash

# Path to the Telethon session file.
# Keep it OUTSIDE the repository, e.g. under your user profile.
TG_SESSION_PATH=C:/Users/you/AppData/Local/referral_finder/referral.session

# Local SQLite database path (relative paths are resolved from the working dir)
DB_PATH=data/messages.db

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Optional: override the chat list location (default: config/chats.txt)
# TG_CHATS_FILE=config/chats.txt

# Optional: AI (DeepSeek) classification. Online calls are OFF by default.
# Set these only if you intend to enable AI. The API key is NOT read from .env:
# set DEEPSEEK_API_KEY as an operating-system environment variable instead.
# LLM_ENABLED=false
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=2
# LLM_MAX_INPUT_CHARS=4000
# LLM_MAX_OUTPUT_TOKENS=400
